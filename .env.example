# Browser-safe Supabase project values. Never place the service-role key here.
# Leave API_BASE_URL empty for the existing deployment. A rehearsal/cutover build
# explicitly selects the Go writer; failures never fall back to the old writer.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Local/E2E fixture submissions only. Never enable on a production Pages build.
NEXT_PUBLIC_DEMO_MODE=false
